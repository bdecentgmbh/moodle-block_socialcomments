{{!
    @template block_socialcomments/form

    Form to write a comment or a reply, or to edit one. It is sent by JavaScript.

    Context variables required for this template:
    * type - comment, reply, editcomment or editreply
    * label - Accessible name of the text field
    * submitlabel - Label of the button that sends the form

    Optional context variables:
    * placeholder - Placeholder of the text field
    * text - The text to edit
    * groups - The groups the comment may go to: id, name
    * groupid - The group of the comment, when there is no choice
    * grouplabel - Accessible name of the group menu

    Example context (json):
    {
        "type": "comment",
        "label": "Write a comment",
        "placeholder": "Write a comment about this activity…",
        "submitlabel": "Post",
        "groups": [{"id": 0, "name": "All groups"}, {"id": 4, "name": "Team North"}],
        "grouplabel": "Group"
    }
}}
<form class="sc-form" data-region="form" data-type="{{type}}">
    <label class="sc-label" for="sc-text-{{uniqid}}">{{label}}</label>
    <textarea id="sc-text-{{uniqid}}" name="content" class="form-control" rows="{{#text}}3{{/text}}{{^text}}2{{/text}}"
        placeholder="{{placeholder}}" data-region="text">{{text}}</textarea>
    <div class="sc-form-actions">
        {{#groups.0}}
        <select class="custom-select form-select form-select-sm sc-form-group" data-region="group" aria-label="{{grouplabel}}">
            {{#groups}}<option value="{{id}}">{{name}}</option>{{/groups}}
        </select>
        {{/groups.0}}
        {{^groups.0}}{{#groupid}}<input type="hidden" data-region="group" value="{{groupid}}">{{/groupid}}{{/groups.0}}
        <button type="button" class="btn btn-secondary btn-sm" data-action="cancel">{{#str}}cancel{{/str}}</button>
        <button type="submit" class="btn btn-primary btn-sm">{{submitlabel}}</button>
    </div>
</form>
