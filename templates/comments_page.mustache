{{!
    @template block_socialcomments/comments_page

    A page of comments with their replies, and the links to the other pages.

    Context variables required for this template:
    * comments - The comments: id, post (context of block_socialcomments/post), canreply, canpin, pinned, pinlabel,
      replies (id, post) and morereplies (text when not all replies are shown)
    * pages - The pages: page (number from 0), label, current
    * currentpage - The number of this page
    * count - The number of comments
    * countlabel - The number of comments, e.g. "3 comments"

    Example context (json):
    {
        "comments": [{
            "id": 1,
            "post": {"fullname": "Amelia Clarke", "time": "5 minutes ago", "exacttime": "29 October 2026, 02:05 PM",
                "datetime": "2026-10-29T14:05:00+01:00", "content": "Great tip, thanks!"},
            "canreply": true,
            "canpin": true,
            "pinned": false,
            "pinlabel": "Pin comment",
            "replies": [{"id": 2, "post": {"fullname": "Laura Bennett", "time": "Just now", "exacttime": "29 October 2026, 02:05 PM",
                "datetime": "2026-10-29T14:05:00+01:00", "content": "You are welcome!"} }]
        }],
        "pages": [],
        "currentpage": 0,
        "count": 1,
        "countlabel": "1 comment"
    }
}}
<ul class="sc-comments" data-region="list" data-page="{{currentpage}}" data-count="{{count}}" data-countlabel="{{countlabel}}">
    {{#comments}}
    <li class="sc-comment" data-region="comment" data-commentid="{{id}}">
        {{#post}}{{> block_socialcomments/post}}{{/post}}
        <div class="sc-post-footer">
            {{#canreply}}
            <button type="button" class="btn btn-link btn-sm sc-reply-button" data-action="reply">
                {{#pix}}reply, block_socialcomments{{/pix}}{{#str}}reply, block_socialcomments{{/str}}
            </button>
            {{/canreply}}
            {{#canpin}}
            <button type="button" class="btn btn-icon sc-pin" data-action="pin" data-commentid="{{id}}"
                aria-pressed="{{#pinned}}true{{/pinned}}{{^pinned}}false{{/pinned}}" title="{{pinlabel}}" aria-label="{{pinlabel}}">
                {{#pix}}pin, block_socialcomments{{/pix}}
            </button>
            {{/canpin}}
        </div>
        <ul class="sc-replies" data-region="replies">
            {{#replies}}
            <li class="sc-reply" data-region="reply" data-replyid="{{id}}">{{#post}}{{> block_socialcomments/post}}{{/post}}</li>
            {{/replies}}
        </ul>
        {{#morereplies}}<p class="sc-more">{{morereplies}}</p>{{/morereplies}}
    </li>
    {{/comments}}
</ul>
{{#pages.0}}
<nav aria-label="{{#str}}pagination, block_socialcomments{{/str}}">
    <ul class="pagination pagination-sm sc-pages">
        {{#pages}}
        <li class="page-item{{#current}} active{{/current}}">
            <a class="page-link" href="#" data-action="page" data-page="{{page}}"{{#current}} aria-current="page"{{/current}}>{{label}}</a>
        </li>
        {{/pages}}
    </ul>
</nav>
{{/pages.0}}
