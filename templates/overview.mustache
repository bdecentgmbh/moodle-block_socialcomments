{{!
    @template block_socialcomments/overview

    Comments of a course grouped by page, as on the newsfeed and the pinboard.

    Context variables required for this template:
    * pages - The pages: name (formatted), url, iconurl, sectionname (formatted) and comments (id, post, replies)

    Example context (json):
    {
        "pages": [{
            "name": "The exposure triangle",
            "url": "#",
            "iconurl": null,
            "sectionname": "Getting to know your camera",
            "comments": [{
                "id": 1,
                "post": {"fullname": "Yuki Tanaka", "time": "Yesterday", "exacttime": "29 October 2026, 02:05 PM",
                "datetime": "2026-10-29T14:05:00+01:00", "content": "Why does a smaller f-number mean a bigger aperture?"},
                "replies": [{"id": 2, "post": {"fullname": "Daniel Okafor", "time": "Yesterday", "exacttime": "29 October 2026, 02:05 PM",
                "datetime": "2026-10-29T14:05:00+01:00", "content": "It is a fraction."} }]
            }]
        }]
    }
}}
<div class="block_socialcomments sc-overview">
{{#pages}}
<section class="sc-overview-page">
    <h3 class="sc-overview-title">
        {{#iconurl}}<img src="{{iconurl}}" class="icon activityicon" alt="">{{/iconurl}}
        {{#url}}<a href="{{url}}">{{{name}}}</a>{{/url}}{{^url}}{{{name}}}{{/url}}
        {{#sectionname}}<span class="sc-overview-section">{{{sectionname}}}</span>{{/sectionname}}
    </h3>
    <ul class="sc-comments">
        {{#comments}}
        <li class="sc-comment">
            {{#post}}{{> block_socialcomments/post}}{{/post}}
            {{#replies.0}}
            <ul class="sc-replies">
                {{#replies}}<li class="sc-reply">{{#post}}{{> block_socialcomments/post}}{{/post}}</li>{{/replies}}
            </ul>
            {{/replies.0}}
        </li>
        {{/comments}}
    </ul>
</section>
{{/pages}}
</div>
