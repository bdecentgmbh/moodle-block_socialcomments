{{!
    @template block_socialcomments/links

    Links of the block to the comments report and the pinboard, and the button to pin the page.

    Optional context variables:
    * reporturl - Link to the comments report
    * pinboardurl - Link to the pinboard
    * canpin, pagepinned, pinpagelabel - Whether the user may pin the page, whether it is pinned, the label of the button

    Example context (json):
    {
        "reporturl": "#",
        "pinboardurl": "#",
        "canpin": true,
        "pagepinned": true,
        "pinpagelabel": "Unpin all comments"
    }
}}
<div class="sc-links">
    {{#reporturl}}<a class="sc-link" href="{{reporturl}}">{{#pix}}report, block_socialcomments{{/pix}}{{#str}}reportspage, block_socialcomments{{/str}}</a>{{/reporturl}}
    {{#pinboardurl}}<a class="sc-link" href="{{pinboardurl}}">{{#pix}}pinboard, block_socialcomments{{/pix}}{{#str}}pinboard, block_socialcomments{{/str}}</a>{{/pinboardurl}}
    {{#canpin}}
    <button type="button" class="btn btn-icon sc-pin" data-action="pin" data-commentid="0"
        aria-pressed="{{#pagepinned}}true{{/pagepinned}}{{^pagepinned}}false{{/pagepinned}}" title="{{pinpagelabel}}" aria-label="{{pinpagelabel}}">
        {{#pix}}pin, block_socialcomments{{/pix}}
    </button>
    {{/canpin}}
</div>
