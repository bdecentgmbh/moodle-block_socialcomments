{{!
    @template block_socialcomments/digest

    The new comments of a course in a digest. It is sent as an email, so it has its styles inline.

    Context variables required for this template:
    * coursename - Name of the course (formatted)
    * pages - Context of block_socialcomments/overview, for the digest

    Example context (json):
    {
        "coursename": "Digital photography basics",
        "pages": [{
            "name": "Course guide &amp; FAQ",
            "url": "#",
            "sectionname": "General",
            "comments": [{
                "id": 1,
                "post": {"fullname": "Priya Natarajan", "time": "29/10/26 02:05 PM", "content": "Can we resubmit the photo walk?"},
                "replies": [{"id": 2, "post": {"fullname": "Laura Bennett", "time": "29/10/26 03:00 PM", "content": "Yes."} }]
            }]
        }]
    }
}}
<h2>{{{coursename}}}</h2>
{{#pages}}
<h3 style="margin: 1.5em 0 .5em;">{{#url}}<a href="{{url}}">{{{name}}}</a>{{/url}}{{^url}}{{{name}}}{{/url}}</h3>
{{#comments}}
<div style="margin: 0 0 1em;">
    {{#post}}<p style="margin: 0;"><strong>{{fullname}}</strong> <span style="color: #6a737b;">{{time}}</span></p>
    <div>{{{content}}}</div>{{/post}}
    {{#replies}}
    <div style="margin: .5em 0 0 1em; padding-left: .75em; border-left: 3px solid #dee2e6;">
        {{#post}}<p style="margin: 0;"><strong>{{fullname}}</strong> <span style="color: #6a737b;">{{time}}</span></p>
        <div>{{{content}}}</div>{{/post}}
    </div>
    {{/replies}}
</div>
{{/comments}}
{{/pages}}
